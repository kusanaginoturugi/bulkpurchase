<% readonly = local_assigns.fetch(:readonly, !order.editable_by_user?) %>
<% form_method = order.persisted? ? :patch : :post %>
<% fellowship_selectable = local_assigns.fetch(:fellowship_selectable, false) %>
<% fellowships = local_assigns.fetch(:fellowships, []) %>
<% form_url = local_assigns.fetch(:form_url, current_order_path) %>
<% back_path = local_assigns[:back_path] %>

<%= form_with model: order, url: form_url, method: form_method, class: "space-y-8", data: { controller: "order-items" } do |form| %>
  <div class="grid gap-6 md:grid-cols-3">
    <div>
      <label class="text-lg font-medium text-stone-700">伝道会名</label>
      <% if fellowship_selectable %>
        <%= form.collection_select :fellowship_id, fellowships, :id, :display_name, {}, disabled: readonly, class: "mt-2 block w-full rounded-xl border border-stone-300 bg-stone-50 px-4 py-3 text-lg focus:border-amber-500 focus:bg-white focus:outline-none disabled:cursor-not-allowed disabled:bg-stone-100" %>
      <% else %>
        <div class="mt-2 rounded-xl border border-stone-200 bg-stone-100 px-4 py-3 text-lg text-stone-700"><%= order.fellowship&.display_name || current_user.fellowship.display_name %></div>
      <% end %>
    </div>
    <div>
      <%= form.label :orderer_name, "注文者名", class: "text-lg font-medium text-stone-700" %>
      <%= form.text_field :orderer_name, readonly:, class: "mt-2 block w-full rounded-xl border border-stone-300 bg-stone-50 px-4 py-3 text-lg focus:border-amber-500 focus:bg-white focus:outline-none disabled:cursor-not-allowed disabled:bg-stone-100" %>
    </div>
    <div>
      <%= form.label :pickup_name, "持ち帰り者名", class: "text-lg font-medium text-stone-700" %>
      <%= form.text_field :pickup_name, readonly:, class: "mt-2 block w-full rounded-xl border border-stone-300 bg-stone-50 px-4 py-3 text-lg focus:border-amber-500 focus:bg-white focus:outline-none disabled:cursor-not-allowed disabled:bg-stone-100" %>
    </div>
  </div>

  <div class="overflow-x-auto rounded-3xl border border-stone-200">
    <div class="min-w-[920px]">
      <div class="grid gap-3 border-b border-stone-200 bg-stone-50 px-4 py-3 text-left text-lg font-semibold uppercase tracking-[0.2em] text-stone-500" style="grid-template-columns: 2fr 1.25fr 0.45fr 0.45fr 13rem;">
        <div>道具名</div>
        <div>種別</div>
        <div>数量</div>
        <div>単位</div>
        <div></div>
      </div>

      <div data-order-items-target="container" class="divide-y divide-stone-200">
        <%= form.fields_for :order_items do |item_fields| %>
          <%= render "current_orders/order_item_fields", f: item_fields, readonly: readonly %>
        <% end %>
      </div>
    </div>
  </div>

  <template data-order-items-target="template">
    <%= form.fields_for :order_items, OrderItem.new(sort_order: order.order_items.size), child_index: "NEW_RECORD" do |item_fields| %>
      <%= render "current_orders/order_item_fields", f: item_fields, readonly: readonly %>
    <% end %>
  </template>

  <div class="flex flex-wrap gap-3 border-t border-stone-200 pt-6">
    <% unless readonly %>
      <%= button_tag "保存", name: "commit_action", value: "save", class: "btn btn-secondary" %>
      <%= button_tag "提出する", name: "commit_action", value: "submit", class: "btn btn-primary" %>
    <% end %>
    <% if order.persisted? %>
      <%= link_to "注文詳細を見る", local_assigns.fetch(:detail_path, order_path(order)), class: "btn btn-secondary" %>
    <% end %>
    <% if back_path.present? %>
      <%= link_to "一覧へ戻る", back_path, class: "btn btn-secondary" %>
    <% end %>
  </div>
<% end %>
