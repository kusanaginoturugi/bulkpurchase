<%= render "admin/shared/header", title: "伝道会編集", description: @fellowship.display_name %>
<section class="rounded-[2rem] border border-stone-200 bg-white p-6 shadow-sm">
  <%= render "form", fellowship: @fellowship %>
  <div class="mt-6 border-t border-stone-200 pt-6">
    <%= button_to "この伝道会を削除", admin_fellowship_path(@fellowship), method: :delete, class: "rounded-xl border border-rose-200 px-5 py-3 text-sm font-medium text-rose-700 hover:bg-rose-50", form: { data: { turbo_confirm: "#{@fellowship.display_name}を削除しますか？" } } %>
  </div>
</section>
