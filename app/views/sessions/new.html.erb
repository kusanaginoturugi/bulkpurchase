<div class="mx-auto max-w-md rounded-[2rem] border border-stone-200 bg-white p-8 shadow-sm">
  <div class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-amber-700">Login</p>
    <h1 class="mt-3 text-3xl font-semibold text-stone-900">注文システムにログイン</h1>
    <p class="mt-2 text-sm text-stone-500">Authentikのアカウントでログインしてください。</p>
  </div>

  <%= button_to "Authentikでログイン", session_url, method: :post, class: "w-full justify-center rounded-xl bg-stone-900 px-5 py-3 text-sm font-medium text-white hover:bg-stone-700" %>

  <% unless Authentik::Client.configured? %>
    <p class="mt-4 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
      Authentikの接続設定が未設定です。
    </p>
  <% end %>
</div>
